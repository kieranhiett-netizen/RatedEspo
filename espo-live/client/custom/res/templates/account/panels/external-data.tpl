<div class="panel panel-default external-data-panel">
    <div class="panel-heading clearfix">
        <h4 class="panel-title pull-left">{{title}}</h4>
        <button
            type="button"
            class="btn btn-default btn-sm pull-right"
            data-action="refresh"
        >
            {{refreshLabel}}
        </button>
    </div>

    <div class="panel-body" data-role="content"></div>
</div>
